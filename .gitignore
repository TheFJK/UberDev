# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / tool noise
.vscode/
.idea/
*.swp
*.swo
*~
# Enumerate *.bak / *.bak[0-9] / *.bak[0-9][0-9] explicitly — *.bak* would
# over-match real files like backup-config.txt or backups/.
*.bak
*.bak[0-9]
*.bak[0-9][0-9]
*.fix

# Merge conflict artifacts
*.orig
*.rej

# OS-level temp
Thumbs.db
ehthumbs.db

# Local-only design docs (kept on disk, not published) — except RFCs and audits which are public
docs/*
!docs/rfc/
# The measured reviewer-precision report (RFC 0018, #432) is a published claim,
# not a local note — README links it and tests/review-precision.test.sh asserts
# it is git-tracked. The directory itself must be un-excluded or git never
# descends into it (same shape as !docs/rfc/ above).
!docs/eval/
!docs/uberdev/
docs/uberdev/*
!docs/uberdev/audits/

# Local-only design notes under the plugin (testing.md is the only tracked file there)
plugins/uberdev/docs/plans/
plugins/uberdev/docs/uberdev/
plugins/uberdev/docs/windows/

# UberDev runtime state (e.g. brainstorm visual companion sessions)
.uberdev/

# Dev scratch — investigation folders, not shipped via the marketplace
goal-cli-2.1.150-fix/

# Node / package manager
node_modules/

# Fixture-app noise — buggy-app is the testers-squad target, package-lock
# regenerates per install host and isn't part of the harness contract.
tests/fixtures/buggy-app/package-lock.json

# Python cache (from plugins/uberdev/skills/testers-pipeline/*.py)
__pycache__/
*.pyc
*.pyo

# Logs
*.log

# Secrets and local config
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa.*
.claude/

# Personal, machine-local Claude instructions (CLAUDE.md itself is tracked — it
# only imports AGENTS.md, so worktrees and fresh clones load the project rules)
CLAUDE.local.md

# Local implementation worktrees (write-plan / subagent-driven-dev)
.worktrees/

# Test scratch directories. Five suites mktemp INTO tests/_fixtures/ and clean
# up on EXIT, but a killed or crashed run leaves the tree behind — and some of
# those fixtures deliberately contain hostile path components (quotes,
# backslashes, tabs) that native Windows CANNOT CHECK OUT. A single `git add -A`
# over that residue therefore produces a commit that reds the Windows job at
# the checkout step, before a single test runs. Ignore the residue so no
# working tree can commit it by accident.
tests/_fixtures/child-dispatch-receipts.*
tests/_fixtures/child-inputs.*
tests/_fixtures/orchestrator-child-inputs.*
tests/_fixtures/review-child-inputs.*
tests/_fixtures/worktree-receipts.*
