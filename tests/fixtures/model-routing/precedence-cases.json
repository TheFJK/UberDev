        "model": "gpt-5.6-sol",
        "reasoning_effort": "ultra"
      }
    },
    "expected": {
      "logical_route": "ultra",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "ultra",
      "forced": true,
      "route_source": "forced-parent",
      "field_sources.model": "forced-parent"
    }
  },
  {
    "name": "environment exact pair shadows project overrides",
    "request": {
      "backend": "codex",
      "workflow": "solve",
      "phase": "review",
      "role": "code-reviewer",
      "task_tier": "medium",
      "environment": {
        "UBERDEV_MODEL": "gpt-5.6-sol",
        "UBERDEV_REASONING_EFFORT": "max"
      },
      "project_config": {
        "roles": {"code-reviewer": "deep"},
        "workflows": {"solve": "quality"}
      }
    },
    "expected": {
      "logical_route": "frontier",
      "forced": true,
      "field_sources.model": "environment-exact",
      "field_sources.reasoning_effort": "environment-exact"
    }
  },
  {
    "name": "project role route beats workflow route",
    "request": {
      "backend": "codex",
      "workflow": "solve",
      "phase": "research",
      "role": "research-codebase",
      "task_tier": "medium",
      "routing_mode": "adaptive",
      "project_config": {
        "roles": {"research-codebase": "quality"},
        "workflows": {"solve": "deep"}
