    },
    "expected": {
      "logical_route": "quality",
      "forced": false,
      "route_source": "project-role",
      "field_sources.model": "project-role"
    }
  },
  {
    "name": "project workflow route beats role policy",
    "request": {
      "backend": "codex",
      "workflow": "solve",
      "phase": "research",
      "role": "research-codebase",
      "task_tier": "medium",
      "routing_mode": "adaptive",
      "project_config": {"workflows": {"solve": "deep"}}
    },
    "expected": {
