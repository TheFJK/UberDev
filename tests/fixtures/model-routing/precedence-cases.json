[
  {
    "name": "cli route shadows environment exact fields",
    "request": {
      "backend": "codex",
      "workflow": "solve",
      "phase": "lead",
      "role": "lead",
      "task_tier": "small",
      "explicit_route": "sol-max",
      "environment": {
        "UBERDEV_MODEL": "gpt-5.6-luna",
        "UBERDEV_REASONING_EFFORT": "low"
      }
    },
    "expected": {
      "logical_route": "frontier",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "max",
      "forced": true,
      "field_sources.model": "cli-route",
      "field_sources.reasoning_effort": "cli-route"
    }
  },
  {
    "name": "cli inherit mode shadows environment route",
    "request": {
      "backend": "codex",
      "workflow": "solve",
      "phase": "lead",
      "role": "lead",
      "task_tier": "small",
      "routing_mode": "inherit",
      "environment": {"UBERDEV_ROUTE": "sol-ultra"}
    },
    "expected": {
      "logical_route": null,
      "model": null,
      "reasoning_effort": null,
      "forced": false,
      "effective_policy": "inherit",
      "field_sources.model": "ambient"
    }
  },
  {
    "name": "forced parent shadows environment route",
    "request": {
      "backend": "codex",
      "workflow": "solve",
      "phase": "research",
      "role": "research-codebase",
      "task_tier": "large",
      "environment": {"UBERDEV_ROUTE": "luna"},
      "parent_run": {
        "forced": true,
