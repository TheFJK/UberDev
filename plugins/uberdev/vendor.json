  "permanent_divergences": [
    {
      "id": "namespace-rebrand",
      "kind": "namespace-rewrite",
      "scope": "all third-party components",
      "note": "Every vendored skill and agent rewrites the 'superpowers:' skill namespace to 'uberdev:'. UberDev ships standalone under its own plugin id, so this can never be reconciled with upstream.",
      "permanent": true
    },
    {
      "id": "parallel-hypothesis-testing",
      "kind": "local-addition",
      "scope": "skills/systematic-debugging",
      "file": "SKILL.md",
      "note": "The local 'Parallel hypothesis testing' section, already recorded in the file's own in-file provenance header. Kept forever.",
      "permanent": true
    },
    {
      "id": "find-polluter-fail-loud",
      "kind": "local-addition",
      "scope": "skills/systematic-debugging",
      "file": "find-polluter.sh",
      "note": "Two local additions to find-polluter.sh (#430), both recorded in the file's own provenance header: (1) fail-loud exit-2 refusals wherever the run cannot back a verdict, and (2) local array-based enumeration that is whitespace- and glob-safe. Upstream returns a green 0 in every refusal shape and its own tests/systematic-debugging/test-find-polluter.sh asserts that green, so a re-sync collides head-on. Re-apply BOTH; tests/find-polluter.test.sh locks them (F12 covers the array-based enumeration, F5/F11/F13 the refusals). Kept forever.",
      "permanent": true
    },
    {
      "id": "brainstorm-no-approval-gates",
      "kind": "policy-divergence",
      "scope": "skills/brainstorm",
      "file": "SKILL.md",
      "note": "UberDev deliberately rejects upstream's HARD-GATE / per-section / spec-review approval checkpoints. Quality comes from parallel research and always-on reviewer agents, not human gates.",
      "permanent": true
    },
    {
      "id": "review-pr-parallel-by-default",
      "kind": "policy-divergence",
      "scope": "skills/requesting-code-review",
      "file": "SKILL.md",
      "note": "/uberdev:review-pr fans out its review lenses in parallel by default; upstream's flow is sequential. Never reconciled.",
      "permanent": true
    },
    {
      "id": "no-co-authored-by",
      "kind": "policy-divergence",
      "scope": "skills/finish-branch",
      "file": "SKILL.md",
      "note": "UberDev never emits a Co-Authored-By or AI-attribution trailer in commits or PR bodies. Upstream's flow does. Never reconciled.",
      "permanent": true
    },
    {
      "id": "interactive-discard-option",
      "kind": "policy-divergence",
      "scope": "skills/finish-branch",
      "file": "SKILL.md",
      "note": "Upstream 6.2.0 stopped offering to discard UNCOMMITTED WORK. UberDev Option 4 is a different thing: it deletes a BRANCH AND ITS COMMITS behind a typed 'discard' confirmation, and it is reachable only under --interactive (the default and turbo paths both auto-select Option 2). Verified by grep at adjudication time (#460): finish-branch/SKILL.md contains no 'git status --porcelain' and no 'stash' — the flow never inspects uncommitted work at all, so treating the two as the same defect is a category error. Adopting upstream's removal here would delete a deliberate, confirmed, opt-in capability. Declined, permanently.",
      "permanent": true
    }
  ],
