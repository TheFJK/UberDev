{
  "schema_version": 1,
  "tree_id": "solve-run-tree-v1",
  "root_edge_id": "solve.issue.lead",
  "scope": {
    "governs": {
      "substrate": "routed-child-dispatch",
      "adapter": "plugins/uberdev/lib/child-dispatch.sh",
      "note": "Every edge in `edges` is a child dispatched through the routed adapter and validated at runtime by lib/child-inputs.py against its required_inputs/optional_inputs. This manifest governs that substrate and no other. The `orchestrator.*` and `sdd.*` edges are reachable ONLY on the non-default --backend=wezterm|background transports; since RFC 0015 the default /solve and /turbo route is the Workflow fleet declared under does_not_govern."
    },
    "agent_kind_rule": "An agent kind is a Workflow agent's opts.label with `:#<issue>` and any trailing ` (<tier>)` removed, the per-task `:t<n>` and per-round `:r<n>` indices collapsed to `:tN` and `:rN`, then `:` mapped to `.` and `-` mapped to `_`. The indices are collapsed because they say which INSTANCE of a rung ran, not what it is: left in, a round-3 reviewer of task 12 is its own kind, the kind space is unbounded, and no enumeration below could satisfy C1 for a chain that actually runs. Derived by execution in tests/solve-run-tree-scope.test.sh, never by grep.",
    "does_not_govern": [
      {
        "substrate": "workflow-native-solve-fleet",
        "source": "plugins/uberdev/skills/solve-fleet/workflow.js",
        "reason": "RFC 0015 made this the DEFAULT /solve + /turbo route. A Workflow script has no filesystem (tests/workflow-scripts.test.sh T1 forbids fs./process.), so it cannot read this manifest and no edge here can constrain it. The gap is real and tracked; it is recorded here so it is visible and machine-checked rather than inferred from a name.",
        "reserved_edge_prefix": "solve_fleet.",
        "dispatch_sites": 14,
        "agent_kinds": [
          "deliver",
          "fix.tN.rN",
          "impl.tN",
          "manifest_intake",
          "plan",
          "plan_review",
          "repo_profile",
          "research.codebase",
          "research.constraints",
          "research.security",
          "research.test_coverage",
          "review.tN.rN",
          "solve",
          "spec",
          "spec_review",
          "spec_revise",
          "verify_prs"
        ],
        "tracking_issues": [
          507,
          508,
          524,
          615
        ]
      },
      {
        "substrate": "session-task-fanout-turbox-fleet",
        "source": "plugins/uberdev/skills/turbox-fleet/SKILL.md",
        "reason": "RFC 0020 added /turbox as a SECOND lane off the same launcher: `--standard` pins the resolved backend to `workflow` and then emits a turbox plan instead of a Workflow args envelope, so the calling SESSION becomes the fleet orchestrator and dispatches every agent through the Task tool. It never sources lib/child-dispatch.sh, so it mints no instance id, creates no handoff, and produces no run-tree edge or receipt — it is neither the governed routed-child substrate nor the Workflow-native one above. RFC 0020 §1 positions this lane as the one that CAN run the parallel-wave implementation phase, so it is a candidate default; a default lane with zero run-tree governance and no declaration of that fact would let this manifest read as full coverage. Recorded here so the gap is visible and machine-checked (#649).",
        "reserved_edge_prefix": "turbox_fleet.",
        "dispatch_sites": 14,
        "agent_kinds": [
          "code_reviewer",
          "general_purpose",
          "implementation_worker",
          "plan_reviewer",
          "plan_writer",
          "research_codebase",
          "research_constraints",
          "research_security",
          "research_test_coverage",
          "spec_compliance_reviewer",
          "spec_reviewer",
          "spec_reviser",
          "spec_writer"
        ],
        "agent_kind_rule": "The rule in scope.agent_kind_rule normalizes a Workflow opts.label and cannot apply here: this lane runs no script, so there is no label to normalize and nothing to execute under the test harness. A kind is instead an agent identifier the source names — `uberdev:<stem>` where plugins/uberdev/agents/<stem>.md exists (which is what excludes the label `uberdev:active`, the command `uberdev:turbox` and the skill `uberdev:orchestrator`), plus the host built-in `general-purpose`, with `-` mapped to `_`. dispatch_sites is the number of such mentions rather than the number of distinct kinds: every one of them is a dispatch instruction, and `implementation-worker` is named at two of them (the Phase 4b wave implementer and the Phase 5 fix round). The Phase 6 delivery rung names no agent type at all, so it contributes no site. Derived from the source by C9 in tests/solve-run-tree-scope.test.sh, never by hand.",
        "tracking_issues": [
          649
        ]
      }
    ]
  },
  "input_limits": {
    "max_serialized_bytes": 49152
  },
