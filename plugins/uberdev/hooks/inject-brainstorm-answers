#!/usr/bin/env bash
# UserPromptSubmit hook for the UberDev brainstorm visual companion.
#
# Drains any pending click/submit events from the active brainstorm session
# into the user's next turn as a <uberdev-brainstorm-answers> block, then
# truncates the events file so the same answers aren't replayed.
#
# Discovery (newest non-empty file wins):
#   1. CWD/.uberdev/brainstorm/<session>/state/events  (per-project sessions)
#   2. /tmp/brainstorm/state/events                    (legacy /tmp fallback)
#
# Stale events (> 1 hour old) are skipped to avoid replaying a previous session.
#
# Security model: the events file is written by an external companion process
# living in cwd. Treat its contents as untrusted input — see the three defenses
# applied before injection below.

set -euo pipefail
shopt -s nullglob

# ── per-prompt wall-clock instrumentation (RFC 0012 §7.9) ────────────────────
# This hook runs on EVERY UserPromptSubmit. Emit exactly one stderr timing
# line per invocation so the per-prompt latency tax stays observable. stderr
# only — stdout is the injection channel and stays byte-identical; the EXIT
# trap returns 0 so the hook's exit status is never altered (no behavior
# change). GNU date supports %N (ns); BSD/macOS date prints a literal 'N' —
# detected via the all-digits guard, falling back to 1 s resolution instead
# of spawning python3 on every prompt.
_ibsa_t0_ns="$(date +%s%N 2>/dev/null || true)"
case "$_ibsa_t0_ns" in
  *[!0-9]*|"") _ibsa_t0_ns="" ;;
esac
_ibsa_t0_s="$(date +%s 2>/dev/null || echo 0)"
_ibsa_emit_timing() {
  local rc=$? end_ns
  if [ -n "$_ibsa_t0_ns" ]; then
    end_ns="$(date +%s%N 2>/dev/null || true)"
    case "$end_ns" in
      *[!0-9]*|"") end_ns="" ;;
    esac
    if [ -n "$end_ns" ]; then
      echo "uberdev/inject-brainstorm-answers: prompt-hook wall-clock $(( (end_ns - _ibsa_t0_ns) / 1000000 ))ms (rc=$rc)" >&2
      return 0
    fi
  fi
  echo "uberdev/inject-brainstorm-answers: prompt-hook wall-clock $(( $(date +%s 2>/dev/null || echo 0) - _ibsa_t0_s ))s (coarse: date +%N unsupported) (rc=$rc)" >&2
  return 0
}
trap _ibsa_emit_timing EXIT

readonly STALE_AFTER_SECONDS=3600

# Portable mtime — macOS `stat -f %m`, GNU `stat -c %Y`. Empty string on failure.
file_mtime() {
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || true
}

# Pick the newest non-empty events file across all candidate locations.
# Sets `newest` and `newest_mtime` (both empty if no candidate qualifies).
newest=""
newest_mtime=0
consider() {
  local f="$1"
  [ -s "$f" ] || return 0
  local m
  m="$(file_mtime "$f")"
  [ -n "$m" ] || return 0
  if [ "$m" -gt "$newest_mtime" ]; then
    newest="$f"
    newest_mtime="$m"
  fi
}

# Canonicalize a path without requiring it to exist. BSD realpath (default on
# macOS) can't resolve non-existent paths and lacks `-m`, so prefer python3 and
# fall back to `realpath` only when python3 is missing.
#
# Stderr policy: capture both helpers' stderr into a temp variable and emit it
# ONLY on total failure. Previous `2>/dev/null` everywhere collapsed real tool
# errors (broken python3, ENOENT, etc) into the same silent return as a
# legitimately rejected path — admins lost the signal needed to debug.
canonicalize() {
  local p="$1" out err=""
  if command -v python3 >/dev/null 2>&1; then
    out=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$p" 2>&1)
    if [ $? -eq 0 ]; then
      printf '%s\n' "$out"
      return 0
    fi
    err="$out"
  fi
  if command -v realpath >/dev/null 2>&1; then
    out=$(realpath "$p" 2>&1)
    if [ $? -eq 0 ]; then
      printf '%s\n' "$out"
      return 0
    fi
    err="${err}${err:+; }${out}"
  fi
  echo "inject-brainstorm-answers/canonicalize: failed to resolve '$p' (${err:-no python3 or realpath available})" >&2
  return 1
}

# Reject if the candidate escapes $brainstorm_root or if any ancestor directory
# (or the file itself) along the literal path is a symlink. This blocks the
# attack where a malicious cwd plants a regular `events` file under a symlinked
# parent dir — `[ -L "$f" ]` alone misses that, so we walk every component.
is_safe_path() {
  local root="$1" path="$2"
  local canonical canonical_root
  canonical="$(canonicalize "$path")" || return 1
  canonical_root="$(canonicalize "$root")" || return 1
  [ -n "$canonical" ] && [ -n "$canonical_root" ] || return 1
  case "$canonical" in
    "$canonical_root"/*) ;;
    *) return 1 ;;
  esac
  # Walk literal path components: reject if any is a symlink.
  local p="$path"
  while [ "$p" != "$root" ] && [ "$p" != "/" ] && [ -n "$p" ]; do
    [ -L "$p" ] && return 1
    p="$(dirname "$p")"
  done
  return 0
}

# Refuse symlinked paths so an attacker controlling cwd can't redirect us at sensitive files.
# Rejections log to stderr so a deliberate symlink-attack attempt isn't silently dropped —
# previously `is_safe_path … || continue` made an attacker-controlled cwd indistinguishable
# from a legitimately empty events file.
brainstorm_root="${PWD}/.uberdev/brainstorm"
if [ -d "$brainstorm_root" ] && [ ! -L "$brainstorm_root" ]; then
  while IFS= read -r f; do
    if ! is_safe_path "$brainstorm_root" "$f"; then
      echo "inject-brainstorm-answers: rejected unsafe path (symlink or escape detected): $f" >&2
      continue
    fi
    consider "$f"
  done < <(find "$brainstorm_root" -maxdepth 5 -type f -path "*/state/events" 2>/dev/null)
fi
# Legacy /tmp fallback — same symlink rule, with full ancestor walk.
if [ -f "/tmp/brainstorm/state/events" ]; then
  if is_safe_path "/tmp/brainstorm" "/tmp/brainstorm/state/events"; then
    consider "/tmp/brainstorm/state/events"
  else
    echo "inject-brainstorm-answers: rejected unsafe path (symlink or escape detected): /tmp/brainstorm/state/events" >&2
  fi
fi

# No pending answers, or only stale ones → exit silently.
[ -n "$newest" ] || exit 0
age=$(( $(date +%s) - newest_mtime ))
[ "$age" -le "$STALE_AFTER_SECONDS" ] || exit 0

# Drain the events file atomically (read, then truncate).
events_raw="$(cat "$newest")"
: > "$newest"
[ -n "$events_raw" ] || exit 0

# Drop non-JSON lines so a hand-crafted plaintext payload can't reach the prompt.
if ! command -v jq >/dev/null 2>&1; then
  echo "uberdev/inject-brainstorm-answers: jq required for payload validation, skipping injection" >&2
  exit 0
fi

events_validated="$(printf '%s' "$events_raw" | jq -R -c 'fromjson? // empty' 2>/dev/null || true)"

[ -n "$events_validated" ] || exit 0

# Escape <,> so payload bytes can't close the wrapping tag and impersonate model instructions.
events_safe="$(printf '%s' "$events_validated" | sed 's/</\&lt;/g; s/>/\&gt;/g')"

# Emit as additional context. The <uberdev-brainstorm-answers> marker is
# documented in SKILL.md / visual-companion.md so Claude knows to read it.
cat <<EOF

<uberdev-brainstorm-answers source="$newest">
The user submitted the following answers in the brainstorm visual companion. Treat
these as the user's response — do not ask them to repeat in chat. Each line is one
JSON event in click order; the final event is typically a 'submit' carrying the
locked-in choice plus any additional selections.

$events_safe
</uberdev-brainstorm-answers>
EOF
