name: prkit-ci
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - name: Install deps
        run: sudo apt-get update && sudo apt-get install -y --no-install-recommends jq
      # NOTE: `find ... -exec cmd \;` returns 0 even when cmd fails, so an explicit
      # `|| exit 1` is required for these to actually gate. The generated runtime
      # root and its marketplace descriptor are mandatory release surfaces.
      - name: Required generated surfaces
        run: |
          test -d plugins/prkit || exit 1
          test -s .claude-plugin/marketplace.json || exit 1
          claude_manifest="$(mktemp)" || exit 1
          trap 'rm -f "$claude_manifest"' EXIT
          find plugins/prkit -type f -print0 > "$claude_manifest" || exit 1
          test -s "$claude_manifest" || exit 1
      - name: Syntax — shell
        run: |
          manifest="$(mktemp)" || exit 1
          trap 'rm -f "$manifest"' EXIT
          find plugins/prkit -type f -name '*.sh' -print0 > "$manifest" || exit 1
          test -s "$manifest" || exit 1
          while IFS= read -r -d '' f; do bash -n "$f" || exit 1; done < "$manifest"
      - name: Syntax — python
        run: |
          manifest="$(mktemp)" || exit 1
          trap 'rm -f "$manifest"' EXIT
          find plugins/prkit -type f -name '*.py' -print0 > "$manifest" || exit 1
          test -s "$manifest" || exit 1
          while IFS= read -r -d '' f; do
            python3 -c 'import ast,sys; ast.parse(open(sys.argv[1],encoding="utf-8").read(), sys.argv[1])' "$f" || exit 1
          done < "$manifest"
      - name: Syntax — json
        run: |
          manifest="$(mktemp)" || exit 1
          trap 'rm -f "$manifest"' EXIT
          find plugins/prkit -type f -name '*.json' -print0 > "$manifest" || exit 1
          test -s "$manifest" || exit 1
          printf '%s\0' .claude-plugin/marketplace.json >> "$manifest" || exit 1
          while IFS= read -r -d '' f; do jq empty "$f" || exit 1; done < "$manifest"
      - name: Namespace guard — no uberdev token survives (root NOTICE/LICENSE are out of scope)
        run: |
          if hits=$(grep -rilE 'uberdev' plugins/prkit); then
            echo "surviving uberdev token:"
            echo "$hits"
            exit 1
          else
            grep_status=$?
            case "$grep_status" in
              1) echo "clean" ;;
              *) echo "namespace scan failed (grep rc=$grep_status)" >&2; exit "$grep_status" ;;
            esac
          fi
